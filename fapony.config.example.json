{
  "worktrees": {
    "myapp": "/absolute/path/to/myapp"
  },
  "review": {
    "maxRounds": 2
  },
  "memory": null,
  "telemetry": null,
  "paths": {
    "doneDir": ".fapony/done",
    "evidenceFile": ".fapony/evidence.json"
  },
  "safety": {
    "deny": [
      "reset\\s+--hard",
      "clean\\s+-[a-z]*f",
      "checkout\\s+--\\s",
      "git\\s+stash"
    ]
  },
  "usageWeb": {
    "port": 1710,
    "hostname": "127.0.0.1",
    "ownerName": "your-name"
  }
}
