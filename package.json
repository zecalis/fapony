{
  "name": "@zecalis/fapony",
  "version": "0.7.5",
  "description": "Token usage across Claude Code, OpenCode, Codex & ZCode on one yardstick — plus plans run chunk by chunk and a convention-debt tracker. No server, your data stays local",
  "license": "MIT",
  "author": "delamind (https://github.com/kire21b)",
  "homepage": "https://github.com/zecalis/fapony#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zecalis/fapony.git"
  },
  "keywords": [
    "agent",
    "token-usage",
    "claude-code",
    "opencode",
    "coding-agent"
  ],
  "bin": {
    "fapony": "fapony.ts"
  },
  "files": [
    "fapony.ts",
    "src/",
    "templates/",
    "skill/"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 20000 --parallel",
    "test:changed": "bun test --timeout 20000 --changed",
    "knip": "bunx knip@6 --exclude types,nsTypes || true",
    "check": "bun run lint && bun run typecheck && bun test --timeout 20000 --parallel",
    "prepublishOnly": "bash scripts/smoke-publish.sh",
    "release": "sh scripts/release.sh",
    "overview": "bun fapony.ts report-web /tmp/fapony-overview.html && open /tmp/fapony-overview.html"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "bun-types": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
