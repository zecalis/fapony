{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.json",
      "**/*.md",
      "!!**/node_modules",
      "!!**/wt-*",
      "!!**/*.db*",
      "!!**/.cursor",
      "!!**/.gemini",
      "!!**/.vscode",
      "!!**/.mcp.json",
      "!!**/.github",
      "!!**/.qoder",
      "!!**/.fapony",
      "!!**/.fael",
      "!!scripts"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noNonNullAssertedOptionalChain": "off",
        "noAssignInExpressions": "off"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  }
}
